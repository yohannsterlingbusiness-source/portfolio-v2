---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Roster from '../components/Roster.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';
import Buzzer from '../components/Buzzer.astro';
import Quarters from '../components/Quarters.astro';
import { services, testimonials } from '../data/site';
import { url } from '../lib/url';
---

<Base>
  <Hero />

  <section class="section" id="projets" data-section="Projets" aria-labelledby="projets-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="projets-title" class="h-section">Projets</h2>
        <a class="link-more" href={url('projets/')}>
          <span class="roll"><span>Tous les projets</span><span aria-hidden="true">Tous les projets</span></span> →
        </a>
      </div>
      <Roster />
    </div>
  </section>

  <section class="section" id="offre" data-section="Offre" aria-labelledby="offre-title">
    <div class="wrap grid offre">
      <div class="offre-head">
        <p class="label">Ce que je fais</p>
        <h2 id="offre-title" class="h-section">Création de présence en ligne</h2>
      </div>
      <ol role="list" class="services">
        {
          services.map((s) => (
            <li class="service">
              <span class="service-n label">{s.n}</span>
              <h3 class="service-title">{s.title}</h3>
              <p class="muted">{s.text}</p>
            </li>
          ))
        }
      </ol>
      <div class="pour-qui">
        <div>
          <h3 class="label">Pour les entreprises</h3>
          <p>Devis détaillé, facture avec TVA, plusieurs interlocuteurs si besoin. Un cadre clair du premier appel à la mise en ligne.</p>
        </div>
        <div>
          <h3 class="label">Pour les particuliers</h3>
          <p>Un forfait simple et rapide, sans jargon. Vous savez ce qui est inclus avant de signer.</p>
        </div>
      </div>
      <a class="link-more offre-link" href={url('offre/')}>
        <span class="roll"><span>Voir l'offre</span><span aria-hidden="true">Voir l'offre</span></span> →
      </a>
    </div>
  </section>

  <section class="section" id="methode" data-section="Méthode" aria-labelledby="methode-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="methode-title" class="h-section">Le match</h2>
        <p class="muted methode-intro">Quatre quart-temps, une prolongation si vous la voulez. Tout est validé par écrit.</p>
      </div>
      <Quarters />
    </div>
  </section>

  <section class="section" id="ce-site" data-section="Ce site" aria-labelledby="ce-site-title">
    <div class="wrap grid">
      <div class="ce-site">
        <p class="label">Étude de cas</p>
        <h2 id="ce-site-title" class="h-section">Ce site est mon premier match.</h2>
        <p class="lead">
          Avant de vous montrer des projets clients, je vous montre celui-ci&nbsp;: le concept, le design system, et ce que chaque
          animation coûte en performance.
        </p>
        <a class="btn btn--ghost" href={url('projets/ce-site/')}>
          <span class="roll"><span>Lire l'étude de cas</span><span aria-hidden="true">Lire l'étude de cas</span></span>
        </a>
      </div>
    </div>
  </section>

  <section class="section" id="a-propos" data-section="À propos" aria-labelledby="apropos-title">
    <div class="wrap grid apropos">
      <PhotoPlaceholder class="apropos-photo" />
      <div class="apropos-text">
        <p class="label">À propos</p>
        <h2 id="apropos-title" class="h-section">Yohann, sur le terrain et à l'écran.</h2>
        <p>
          Ingénieur informatique diplômé du CESI, en MBA Big Data &amp; IA. Camerounais, installé en France, élevé dans une culture
          anglo-saxonne. Basket en club, salle presque tous les jours, NBA&nbsp;2K le soir.
        </p>
        <p>Je construis des sites comme je joue&nbsp;: lire le jeu d'abord, exécuter proprement ensuite.</p>
        <a class="link-more" href={url('a-propos/')}>
          <span class="roll"><span>En savoir plus</span><span aria-hidden="true">En savoir plus</span></span> →
        </a>
      </div>
    </div>
  </section>

  {
    testimonials.length > 0 && (
      <section class="section" id="temoignages" data-section="Témoignages" aria-labelledby="temoignages-title">
        <div class="wrap">
          <h2 id="temoignages-title" class="h-section">Ils l'ont dit</h2>
          <ul role="list" class="testimonials">
            {testimonials.map((t) => (
              <li>
                <figure>
                  <blockquote>
                    <p>{t.quote}</p>
                  </blockquote>
                  <figcaption class="label">
                    {t.name} · {t.company}
                  </figcaption>
                </figure>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <Buzzer />
</Base>

<style>
  .link-more {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 44px;
    font-weight: 600;
    text-decoration: none;
  }

  /* Offre */
  .offre {
    row-gap: var(--s-7);
  }

  .offre-head,
  .services,
  .pour-qui,
  .offre-link {
    grid-column: 1 / -1;
  }

  .offre-head {
    display: grid;
    gap: var(--s-3);
  }

  .services {
    display: grid;
    border-top: 1px solid var(--c-ligne);
  }

  .service {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: var(--s-2) var(--s-4);
    padding-block: var(--s-5);
    border-bottom: 1px solid var(--c-ligne);
  }

  .service-n {
    grid-row: span 2;
    padding-top: 0.4em;
  }

  .service-title {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: var(--fs-3);
    line-height: var(--lh-title);
    text-transform: uppercase;
  }

  .service p {
    max-width: var(--measure);
  }

  .pour-qui {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: var(--s-6) var(--gutter);
  }

  .pour-qui > div {
    display: grid;
    gap: var(--s-2);
    padding: var(--s-5);
    border: 1px solid var(--c-ligne);
    border-radius: 10px;
  }

  @media (min-width: 1024px) {
    .offre-head {
      grid-column: 1 / span 5;
      align-self: start;
      position: sticky;
      top: calc(var(--header-h) + var(--s-6));
    }

    .services,
    .pour-qui,
    .offre-link {
      grid-column: 6 / -1;
    }
  }

  /* Méthode */
  .methode-intro {
    max-width: 36ch;
  }

  /* Ce site */
  .ce-site {
    grid-column: 1 / -1;
    display: grid;
    gap: var(--s-5);
    justify-items: start;
  }

  @media (min-width: 1024px) {
    .ce-site {
      grid-column: 3 / span 8;
    }
  }

  /* À propos */
  .apropos {
    row-gap: var(--s-7);
    align-items: center;
  }

  .apropos :global(.apropos-photo) {
    grid-column: 1 / -1;
    max-width: 420px;
  }

  .apropos-text {
    grid-column: 1 / -1;
    display: grid;
    gap: var(--s-5);
    justify-items: start;
  }

  .apropos-text p {
    max-width: var(--measure);
  }

  @media (min-width: 640px) {
    .apropos :global(.apropos-photo) {
      grid-column: 1 / span 3;
    }

    .apropos-text {
      grid-column: 4 / -1;
    }
  }

  @media (min-width: 1024px) {
    .apropos :global(.apropos-photo) {
      grid-column: 1 / span 4;
    }

    .apropos-text {
      grid-column: 6 / span 6;
    }
  }

  /* Témoignages */
  .testimonials {
    display: grid;
    gap: var(--s-6);
    margin-top: var(--s-7);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
  }

  .testimonials blockquote {
    margin: 0 0 var(--s-4);
    font-size: var(--fs-1);
  }
</style>
