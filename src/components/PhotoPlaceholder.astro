---
// Emplacement photo dans la direction artistique : silhouette duotone, en attendant la vraie séance.
interface Props {
  label?: string;
  class?: string;
}

const { label = 'Portrait de Yohann', class: className = '' } = Astro.props;
---

<figure class:list={['photo', className]}>
  <svg viewBox="0 0 400 500" role="img" aria-label={`${label} (photo à venir)`}>
    <defs>
      <radialGradient id="ph-light" cx="72%" cy="18%" r="80%">
        <stop offset="0" stop-color="#2a2a2e"></stop>
        <stop offset="1" stop-color="#0b0b0c"></stop>
      </radialGradient>
    </defs>
    <rect width="400" height="500" fill="url(#ph-light)"></rect>
    <rect x="0" y="0" width="400" height="500" fill="none" stroke="#ff4d2e" stroke-opacity=".5" stroke-width="2" stroke-dasharray="2 10"></rect>
    <circle cx="200" cy="185" r="72" fill="#1b1b1e"></circle>
    <path d="M60 500 C70 350 130 300 200 300 C270 300 330 350 340 500 Z" fill="#1b1b1e"></path>
    <path d="M300 60 L340 60" stroke="#ff4d2e" stroke-width="3"></path>
  </svg>
  <figcaption class="label">[Photo à venir]</figcaption>
</figure>

<style>
  .photo {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 8px;
    background: var(--c-banc);
  }

  svg {
    width: 100%;
    height: 100%;
  }

  figcaption {
    position: absolute;
    left: var(--s-3);
    bottom: var(--s-3);
    padding: var(--s-1) var(--s-2);
    background: var(--c-nuit);
    color: var(--c-craie);
    border-radius: 4px;
  }
</style>
