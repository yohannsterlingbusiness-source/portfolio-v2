---
// Moment mémorable : le chrono arrive à 0.0 sur cette section, et le survol déclenche une impact frame
// façon anime de sport. Pur CSS : activée à l'entrée de la souris, estompée à sa sortie.
import ShotClock from './ShotClock.astro';
import ContactButton from './ContactButton.astro';
import { site } from '../data/site';

const rays = Array.from({ length: 28 }, (_, i) => {
  const a = (i / 28) * Math.PI * 2;
  const r1 = 34 + (i % 3) * 6;
  return {
    x1: 50 + Math.cos(a) * r1,
    y1: 50 + Math.sin(a) * r1,
    x2: 50 + Math.cos(a) * 90,
    y2: 50 + Math.sin(a) * 90,
    w: i % 2 ? 0.6 : 1.4,
  };
});
---

<section class="buzzer" id="buzzer" data-section="Contact" data-buzzer data-clock-end aria-labelledby="buzzer-title">
  <svg class="rays" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    {rays.map((r) => <line x1={r.x1} y1={r.y1} x2={r.x2} y2={r.y2} stroke-width={r.w} />)}
  </svg>

  <div class="wrap buzzer-inner">
    <div class="buzzer-clock">
      <ShotClock value="0.0" name="progress" />
    </div>
    <h2 id="buzzer-title" class="display buzzer-title">Dernière possession.</h2>
    <p class="buzzer-sub">On la joue ensemble&nbsp;?</p>
    <div class="buzzer-actions">
      <ContactButton label="Soyons coéquipiers" />
      <a class="buzzer-mail" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </div>
</section>

<style>
  .buzzer {
    position: relative;
    overflow: hidden;
    padding-block: var(--section-pad);
    border-top: 1px solid var(--c-ligne);
    text-align: center;
    isolation: isolate;
    transition: background-color 350ms var(--ease-out), color 350ms var(--ease-out);
  }

  .buzzer-inner {
    display: grid;
    justify-items: center;
    gap: var(--s-5);
  }

  .buzzer-clock {
    padding: 0.12em 0.2em;
    border: 1px solid var(--c-ligne);
    border-radius: 12px;
    background: #000;
    font-size: clamp(56px, 10vw, 120px);
  }

  .buzzer-title {
    margin-top: var(--s-5);
    font-size: var(--fs-6);
    text-wrap: balance;
  }

  .buzzer-sub {
    font-size: var(--fs-2);
  }

  .buzzer-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--s-4) var(--s-6);
    margin-top: var(--s-4);
  }

  .buzzer-mail {
    overflow-wrap: anywhere;
  }

  .buzzer-title,
  .buzzer-clock {
    transition: transform 350ms var(--ease-out), box-shadow 350ms var(--ease-out);
  }

  .rays {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    stroke: var(--c-nuit);
    opacity: 0;
    transform: scale(1.15);
    transition: opacity 350ms var(--ease-out), transform 350ms var(--ease-out);
  }

  /* Impact frame au survol : fort contraste, lignes de vitesse, titre secoué. Entrée rapide, sortie douce. */
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .buzzer:hover {
      background: var(--c-craie);
      color: var(--c-nuit);
      transition-duration: 160ms;
    }

    .buzzer:hover .rays {
      opacity: 1;
      transform: scale(1);
      transition-duration: 160ms;
    }

    .buzzer:hover .buzzer-title {
      transform: scale(1.06) rotate(-2deg);
      transition-duration: 160ms;
    }

    .buzzer:hover .buzzer-clock {
      transform: scale(1.1) rotate(3deg);
      box-shadow: 0 0 0 6px var(--c-nuit);
      transition-duration: 160ms;
    }

    .buzzer:hover :focus-visible {
      outline-color: var(--c-nuit);
    }
  }
</style>

