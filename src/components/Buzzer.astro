---
// Moment mémorable : quand le chrono atteint 0.0, une impact frame façon anime de sport (une fois par session).
import ShotClock from './ShotClock.astro';
import ContactButton from './ContactButton.astro';
import { site } from '../data/site';

const rays = Array.from({ length: 28 }, (_, i) => {
  const a = (i / 28) * Math.PI * 2;
  const r1 = 34 + (i % 3) * 6;
  return {
    x1: 50 + Math.cos(a) * r1,
    y1: 50 + Math.sin(a) * r1,
    x2: 50 + Math.cos(a) * 90,
    y2: 50 + Math.sin(a) * 90,
    w: i % 2 ? 0.6 : 1.4,
  };
});
---

<section class="buzzer" id="buzzer" data-section="Contact" data-buzzer data-clock-end aria-labelledby="buzzer-title">
  <svg class="rays" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    {rays.map((r) => <line x1={r.x1} y1={r.y1} x2={r.x2} y2={r.y2} stroke-width={r.w} />)}
  </svg>

  <div class="wrap buzzer-inner">
    <div class="buzzer-clock">
      <ShotClock value="0.0" name="progress" />
    </div>
    <h2 id="buzzer-title" class="display buzzer-title">Dernière possession.</h2>
    <p class="buzzer-sub">On la joue ensemble&nbsp;?</p>
    <div class="buzzer-actions">
      <ContactButton label="Soyons coéquipiers" />
      <a class="buzzer-mail" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </div>
</section>

<script>
  import { reducedMotion } from '../scripts/clock';

  // L'impact frame se déclenche quand le chrono atteint 0.0 (événement clock:zero émis par le Header).
  // Souris : il reste figé tant que le pointeur est dans la section et s'estompe à sa sortie.
  // Tactile : il s'estompe après 400 ms.
  const el = document.querySelector<HTMLElement>('[data-buzzer]');
  const mouse = matchMedia('(hover: hover) and (pointer: fine)').matches;

  if (el) {
    let minUntil = 0;

    const release = () => {
      const wait = minUntil - Date.now();
      if (wait > 0) return setTimeout(release, wait);
      if (mouse && el.matches(':hover')) return;
      el.classList.remove('is-impact');
    };

    document.addEventListener('clock:zero', () => {
      if (reducedMotion() || el.classList.contains('is-impact')) return;
      minUntil = Date.now() + 400;
      el.classList.add('is-impact');
      setTimeout(release, 400);
    });

    el.addEventListener('pointerleave', () => el.classList.contains('is-impact') && release());
  }
</script>

<style>
  .buzzer {
    position: relative;
    overflow: hidden;
    padding-block: var(--section-pad);
    border-top: 1px solid var(--c-ligne);
    text-align: center;
    isolation: isolate;
  }

  .buzzer-inner {
    display: grid;
    justify-items: center;
    gap: var(--s-5);
  }

  .buzzer-clock {
    padding: 0.12em 0.2em;
    border: 1px solid var(--c-ligne);
    border-radius: 12px;
    background: #000;
    font-size: clamp(56px, 10vw, 120px);
  }

  .buzzer-title {
    margin-top: var(--s-5);
    font-size: var(--fs-6);
    text-wrap: balance;
  }

  .buzzer-sub {
    font-size: var(--fs-2);
  }

  .buzzer-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--s-4) var(--s-6);
    margin-top: var(--s-4);
  }

  .buzzer-mail {
    overflow-wrap: anywhere;
  }

  .rays {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    stroke: var(--c-nuit);
    opacity: 0;
  }

  /* Impact frame : image figée en fort contraste, lignes de vitesse, une seule fois, sans clignotement */
  .buzzer.is-impact {
    background: var(--c-craie);
    color: var(--c-nuit);
  }

  .buzzer.is-impact .rays {
    opacity: 1;
    animation: rays-in 400ms steps(2, end) both;
  }

  .buzzer.is-impact .buzzer-title {
    transform: scale(1.08) rotate(-2deg);
  }

  .buzzer.is-impact .buzzer-clock {
    transform: scale(1.12) rotate(3deg);
    box-shadow: 0 0 0 6px var(--c-nuit);
  }

  .buzzer-title,
  .buzzer-clock {
    transition: transform 300ms var(--ease-out);
  }

  .buzzer {
    transition: background-color 300ms var(--ease-out), color 300ms var(--ease-out);
  }

  /* Entrée sèche (coupe franche), sortie en douceur */
  .buzzer.is-impact,
  .buzzer.is-impact .buzzer-title,
  .buzzer.is-impact .buzzer-clock {
    transition: none;
  }

  @keyframes rays-in {
    from {
      transform: scale(1.15);
    }
    to {
      transform: scale(1);
    }
  }
</style>
