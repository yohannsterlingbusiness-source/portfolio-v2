---
// Appel à l'action de fin de page (hors accueil, qui a le buzzer).
import ContactButton from './ContactButton.astro';
import ShotClock from './ShotClock.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  text?: string;
}

const { title, text } = Astro.props;
---

<section class="cta" id="contact-cta" data-section="Contact" data-clock-end aria-labelledby="cta-title">
  <div class="wrap cta-inner">
    <div class="cta-clock">
      <ShotClock name="progress" />
    </div>
    <h2 id="cta-title" class="display cta-title">{title}</h2>
    {text && <p class="cta-text">{text}</p>}
    <div class="cta-actions">
      <ContactButton label="Soyons coéquipiers" />
      <a class="cta-mail" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: var(--section-pad);
    border-top: 1px solid var(--c-ligne);
  }

  .cta-inner {
    display: grid;
    justify-items: start;
    gap: var(--s-5);
  }

  .cta-clock {
    padding: 0.12em 0.2em;
    border: 1px solid var(--c-ligne);
    border-radius: 10px;
    background: #000;
    font-size: clamp(40px, 6vw, 72px);
  }

  .cta-title {
    font-size: var(--fs-5);
    line-height: 1;
    max-width: 14ch;
    text-wrap: balance;
  }

  .cta-text {
    font-size: var(--fs-1);
    max-width: 40ch;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4) var(--s-6);
    margin-top: var(--s-3);
  }

  .cta-mail {
    overflow-wrap: anywhere;
  }
</style>
