---
// Schéma tactique de la démarche : une étape = un joueur, une flèche = une passe, le dernier trait = le tir.
// Le schéma se trace quand il arrive à l'écran. Sans JS ou en mouvement réduit, il est affiché complet.
interface Props {
  steps: string[];
}

const { steps } = Astro.props;
const n = steps.length;
const HOOP = { x: 548, y: 170 };

const nodes = steps.map((_, i) => ({
  x: 60 + (i * 340) / Math.max(1, n - 1),
  y: i % 2 === 0 ? 268 : 120,
}));

const arrowHead = (x: number, y: number, cx: number, cy: number) => {
  const a = (Math.atan2(y - cy, x - cx) * 180) / Math.PI;
  return `translate(${x} ${y}) rotate(${a})`;
};

// Passes entre étapes : courbes qui s'arrêtent au bord du cercle d'arrivée
const passes = nodes.slice(0, -1).map((p, i) => {
  const q = nodes[i + 1];
  const cx = (p.x + q.x) / 2;
  const cy = Math.min(p.y, q.y) - 46;
  const dx = q.x - cx;
  const dy = q.y - cy;
  const len = Math.hypot(dx, dy);
  const ex = q.x - (dx / len) * 24;
  const ey = q.y - (dy / len) * 24;
  return { d: `M${p.x} ${p.y} Q${cx} ${cy} ${ex} ${ey}`, head: arrowHead(ex, ey, cx, cy) };
});

const last = nodes[n - 1];
const shotCtrl = { x: (last.x + HOOP.x) / 2, y: Math.min(last.y, HOOP.y) - 110 };
const shot = `M${last.x} ${last.y - 22} Q${shotCtrl.x} ${shotCtrl.y} ${HOOP.x} ${HOOP.y - 12}`;
---

<div class="playbook" data-playbook>
  <svg viewBox="0 0 600 340" role="img" aria-label={`Schéma de la démarche en ${n} étapes, détaillées dans la liste`}>
    <g class="pb-court">
      <rect x="10" y="10" width="580" height="320" rx="4"></rect>
      <path d="M590 30 L500 30 A190 190 0 0 0 500 310 L590 310"></path>
      <rect x="440" y="110" width="150" height="120"></rect>
      <circle cx="440" cy="170" r="50"></circle>
      <line x1="566" y1="145" x2="566" y2="195"></line>
    </g>
    <circle class="pb-rim" cx={HOOP.x} cy={HOOP.y} r="12"></circle>

    {
      passes.map((p, i) => (
        <g class="pb-pass" style={`--i:${i}`}>
          <path d={p.d} pathLength="1" />
          <polygon points="0,0 -11,-6 -11,6" transform={p.head} />
        </g>
      ))
    }

    <path class="pb-shot" style={`--i:${n - 1}`} d={shot} pathLength="1"></path>

    {
      nodes.map((p, i) => (
        <g class="pb-node" style={`--i:${i}`}>
          <circle cx={p.x} cy={p.y} r="22" />
          <text x={p.x} y={p.y + 8} text-anchor="middle">
            {i + 1}
          </text>
        </g>
      ))
    }
  </svg>

  <ol class="pb-steps" role="list">
    {
      steps.map((s, i) => (
        <li>
          <span class="pb-n display">{String(i + 1).padStart(2, '0')}</span>
          <span class:list={{ 'placeholder-text': s.startsWith('[') }}>{s}</span>
        </li>
      ))
    }
  </ol>
</div>

<script>
  import { reducedMotion } from '../scripts/clock';

  document.querySelectorAll<HTMLElement>('[data-playbook]').forEach((el) => {
    if (reducedMotion()) return;
    el.classList.add('will-draw');
    const io = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        el.classList.add('is-drawn');
        io.disconnect();
      },
      { threshold: 0.4 },
    );
    io.observe(el);
  });
</script>

<style>
  .playbook {
    display: grid;
    gap: var(--s-6);
  }

  svg {
    width: 100%;
    height: auto;
    border-radius: 8px;
    background: var(--c-banc);
  }

  .pb-court {
    fill: none;
    stroke: var(--c-craie);
    stroke-opacity: 0.18;
    stroke-width: 1.5;
  }

  .pb-rim {
    fill: none;
    stroke: var(--c-led);
    stroke-width: 3;
  }

  .pb-pass path {
    fill: none;
    stroke: var(--c-craie);
    stroke-width: 2.5;
    stroke-linecap: round;
  }

  .pb-pass polygon {
    fill: var(--c-craie);
  }

  .pb-shot {
    fill: none;
    stroke: var(--c-led);
    stroke-width: 3;
    stroke-linecap: round;
  }

  .pb-node circle {
    fill: var(--c-nuit);
    stroke: var(--c-led);
    stroke-width: 2.5;
  }

  .pb-node text {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: 24px;
    fill: var(--c-craie);
  }

  /* Tracé séquentiel : chaque étape apparaît, puis sa passe se dessine vers la suivante */
  .will-draw .pb-node {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0.6);
  }

  .will-draw .pb-pass path,
  .will-draw .pb-shot {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  .will-draw .pb-pass polygon {
    opacity: 0;
  }

  .is-drawn .pb-node {
    opacity: 1;
    transform: none;
    transition: opacity 200ms var(--ease-out), transform 300ms var(--ease-out);
    transition-delay: calc(var(--i) * 420ms);
  }

  .is-drawn .pb-pass path,
  .is-drawn .pb-shot {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 380ms var(--ease-inout);
    transition-delay: calc(var(--i) * 420ms + 180ms);
  }

  .is-drawn .pb-pass polygon {
    opacity: 1;
    transition: opacity 120ms linear;
    transition-delay: calc(var(--i) * 420ms + 520ms);
  }

  .pb-steps {
    display: grid;
    gap: var(--s-4);
  }

  .pb-steps li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    align-items: baseline;
    gap: var(--s-3);
    padding-bottom: var(--s-4);
    border-bottom: 1px solid var(--c-ligne);
  }

  .pb-n {
    font-size: var(--fs-3);
    color: var(--c-led);
  }

  @media (min-width: 1024px) {
    .playbook {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: center;
      gap: var(--gutter);
    }
  }
</style>
