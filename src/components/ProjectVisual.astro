---
// Visuel placeholder : un demi-terrain en traits, avec une zone en rouge et un angle propres à chaque projet.
interface Props {
  angle?: number;
  zone?: 'key' | 'corner' | 'arc' | 'center';
  number: string;
  placeholder?: boolean;
  /** Format du cadre, ex. "21 / 9". Le dessin est recadré pour le remplir. */
  ratio?: string;
}

const { angle = 0, zone = 'key', number, placeholder = true, ratio = '16 / 10' } = Astro.props;
const t = `translate(200 125) rotate(${angle}) scale(1.3) translate(-200 -125)`;
---

<div class="visual" style={`aspect-ratio: ${ratio}`}>
  <svg
    viewBox="0 0 400 250"
    preserveAspectRatio="xMidYMid slice"
    role="img"
    aria-label={placeholder ? `Visuel à venir pour le projet ${number}` : `Visuel du projet ${number}`}
  >
    <rect width="400" height="250" class="v-bg"></rect>
    <text x="392" y="236" text-anchor="end" class="v-num">{number}</text>
    <g transform={t}>
      {zone === 'key' && <rect x="160" y="140" width="80" height="100" class="v-zone" />}
      {zone === 'arc' && <circle cx="200" cy="140" r="40" class="v-zone" />}
      {zone === 'corner' && <rect x="40" y="200" width="30" height="40" class="v-zone" />}
      {zone === 'center' && <circle cx="200" cy="10" r="40" class="v-zone" />}
      <g class="v-lines">
        <rect x="40" y="10" width="320" height="230"></rect>
        <rect x="160" y="140" width="80" height="100"></rect>
        <circle cx="200" cy="140" r="40"></circle>
        <path d="M70 240 L70 200 A135 135 0 0 1 330 200 L330 240"></path>
        <circle cx="200" cy="10" r="40"></circle>
        <line x1="182" y1="232" x2="218" y2="232"></line>
        <circle cx="200" cy="222" r="7"></circle>
      </g>
    </g>
  </svg>
  {placeholder && <span class="v-tag label">[Visuel à venir]</span>}
</div>

<style>
  .visual {
    position: relative;
    overflow: hidden;
    border-radius: 6px;
  }

  svg {
    width: 100%;
    height: 100%;
  }

  .v-bg {
    fill: var(--c-banc);
  }

  .v-zone {
    fill: var(--c-led);
  }

  .v-lines {
    fill: none;
    stroke: var(--c-craie);
    stroke-opacity: 0.4;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .v-num {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: 120px;
    fill: var(--c-nuit);
  }

  .v-tag {
    position: absolute;
    left: var(--s-3);
    bottom: var(--s-3);
    padding: var(--s-1) var(--s-2);
    background: var(--c-nuit);
    color: var(--c-craie);
    border-radius: 4px;
  }
</style>
