---
// Fiche joueur : maillot, nom, poste, et la box score avec les résultats réels du projet.
import type { CollectionEntry } from 'astro:content';
import ProjectVisual from './ProjectVisual.astro';

interface Props {
  project: CollectionEntry<'projets'>;
  /** Sans en-tête, quand le nom du projet est déjà affiché juste au-dessus. */
  compact?: boolean;
  /** Rend toute la fiche cliquable vers l'étude de cas. */
  href?: string;
  /** Niveau du titre selon la page (h2 sous un h1 de page, h3 dans une section). */
  level?: 2 | 3;
}

const { project, compact = false, href, level = 3 } = Astro.props;
const { data } = project;
const isPh = (v: string) => v.startsWith('[');
const Heading = level === 2 ? 'h2' : 'h3';
---

<article class:list={['card', { 'is-link': href }]}>
  <div class="card-grid">
  <ProjectVisual angle={data.visual.angle} zone={data.visual.zone} number={data.number} placeholder={data.placeholder} />
  <div class="card-info">
  <div class="card-head" hidden={compact}>
    <span class="card-num display" aria-hidden="true">{data.number}</span>
    <div>
      <p class="label">{data.client} · <span class:list={{ 'placeholder-text': isPh(data.type) }}>{data.type}</span></p>
      <Heading class="card-title" class:list={{ 'placeholder-text': isPh(data.title) }}>
        {href ? <a class="card-link" href={href}>{data.title}</a> : data.title}
      </Heading>
    </div>
  </div>
  <dl class="box">
    {
      data.stats.map((s) => (
        <div class="box-cell">
          <dt class="label">{s.label}</dt>
          <dd class:list={['box-val', { 'is-ph': isPh(s.value) }]}>{s.value}</dd>
        </div>
      ))
    }
  </dl>
  </div>
  </div>
</article>

<style>
  .card {
    padding: var(--s-4);
    border: 1px solid var(--c-ligne);
    border-radius: 10px;
    background: linear-gradient(180deg, var(--c-banc), var(--c-nuit));
    container-type: inline-size;
  }

  .card-grid,
  .card-info {
    display: grid;
    gap: var(--s-5);
  }

  /* Fiche large (ex. épinglée en pleine largeur) : visuel à gauche, infos à droite */
  @container (min-width: 760px) {
    .card-grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      align-items: center;
      gap: var(--s-5) var(--s-7);
    }
  }

  /* Fiche cliquable : le lien du titre couvre toute la carte */
  .card.is-link {
    position: relative;
    transition: border-color var(--t-hover) var(--ease-out), transform var(--t-base) var(--ease-out);
  }

  .card-link {
    text-decoration: none;
  }

  .card-link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .card-link:focus-visible {
    outline: none;
  }

  .card.is-link:hover,
  .card.is-link:focus-within {
    border-color: var(--c-led);
  }

  .card.is-link:has(.card-link:focus-visible) {
    outline: var(--focus-ring);
    outline-offset: 3px;
  }

  .card.is-link:hover .card-num,
  .card.is-link:focus-within .card-num {
    color: var(--c-led);
  }

  @media (prefers-reduced-motion: no-preference) {
    .card.is-link:hover {
      transform: translateY(-4px);
    }
  }

  .card-head {
    display: flex;
    align-items: center;
    gap: var(--s-4);
  }

  .card-num {
    font-size: var(--fs-5);
    color: transparent;
    -webkit-text-stroke: 1.5px var(--c-led);
  }

  .card-title {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: var(--fs-2);
    line-height: var(--lh-title);
    text-transform: uppercase;
  }

  .box {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--c-ligne);
  }

  @container (min-width: 560px) {
    .box {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .box-cell {
    padding: var(--s-3) var(--s-2) 0 0;
  }

  .box-val {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: var(--fs-2);
    line-height: 1.1;
    overflow-wrap: anywhere;
  }

  .box-val.is-ph {
    font-family: var(--f-text);
    font-weight: 500;
    font-size: var(--fs--1);
    font-style: italic;
    color: var(--c-parquet);
    padding-top: var(--s-2);
  }
</style>
