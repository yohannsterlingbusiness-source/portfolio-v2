---
// Le match : le processus en 4 quart-temps et une prolongation.
// Au survol, une balle dribble le long de la ligne pendant que la période s'écoule.
import { quarters } from '../data/site';
---

<ol role="list" class="quarters">
  {
    quarters.map((q) => (
      <li class:list={['quarter', { 'is-ot': q.q === 'OT' }]}>
        <span class="quarter-ball" aria-hidden="true" />
        <span class="quarter-q display">{q.q}</span>
        <h3 class="quarter-title">{q.title}</h3>
        <p class="muted">{q.text}</p>
      </li>
    ))
  }
</ol>

<style>
  .quarters {
    display: grid;
    gap: var(--s-6) var(--gutter);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
  }

  .quarter {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--s-2);
    padding-top: var(--s-4);
    border-top: 2px solid var(--c-craie);
    container-type: inline-size;
  }

  .quarter.is-ot {
    border-top-style: dashed;
    border-top-color: var(--c-parquet);
  }

  /* Survol : la période s'écoule (ligne rouge) pendant qu'une balle dribble le long de la ligne */
  .quarter::before {
    content: '';
    position: absolute;
    top: -2px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--c-led);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 200ms var(--ease-out);
  }

  .quarter-ball {
    position: absolute;
    top: -14px;
    left: 0;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #ff8a63, var(--c-led) 60%, #b8321a);
    opacity: 0;
    pointer-events: none;
    transform-origin: 50% 100%;
    transition: opacity 150ms linear;
  }

  @media (hover: hover) {
    .quarter:hover::before {
      transform: scaleX(1);
      transition: transform 720ms linear;
    }

    .quarter:hover .quarter-ball {
      opacity: 1;
      animation:
        q-travel 720ms linear both,
        q-dribble 240ms 3 both;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .quarter-ball {
      display: none;
    }
  }

  @keyframes q-travel {
    from {
      translate: 0 0;
    }
    to {
      translate: calc(100cqw - 12px) 0;
    }
  }

  /* Dribble : chute accélérée, écrasement au contact du sol, remontée qui ralentit */
  @keyframes q-dribble {
    0% {
      transform: translateY(-22px);
      animation-timing-function: var(--ease-fall);
    }
    48% {
      transform: translateY(0) scale(1, 1);
      animation-timing-function: linear;
    }
    52% {
      transform: translateY(1px) scale(1.2, 0.78);
      animation-timing-function: var(--ease-rise);
    }
    100% {
      transform: translateY(-22px);
    }
  }

  .quarter-q {
    font-size: var(--fs-4);
    color: var(--c-led);
  }

  .quarter-title {
    font-size: var(--fs-1);
    font-weight: 600;
    line-height: 1.25;
  }

</style>
